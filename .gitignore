# ============================================
# Codex of Azeroth :: .gitignore
# ============================================

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de editores
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Backups de SavedVariables (los usuarios pueden generarlos al usar el addon)
SavedVariables/
*.bak

# Builds de paquetes
*.zip
*.rar
*.7z
*.tar.gz

# Logs
*.log

# Archivos temporales de Lua
*.luac
*.lua.bak

# Archivos de configuración personal
.env
config.local.lua
